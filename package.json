{
  "name": "house-style-render-ts",
  "version": "0.1.1",
  "description": "TypeScript renderer for the AI-Lab house style. Markdown → house-styled HTML via preprocessor + remark/rehype pipeline + medium-specific adapters (React, vanilla, email).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./styles/tokens.css",
    "./components.css": "./styles/components.css",
    "./preprocessor": {
      "import": "./dist/preprocessor.js",
      "types": "./dist/preprocessor.d.ts"
    },
    "./email": {
      "import": "./dist/adapters/email.js",
      "types": "./dist/adapters/email.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amaranta-ays/house-style-render-ts.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "unified": "^11.0.4",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.0",
    "remark-rehype": "^11.1.0",
    "rehype-stringify": "^10.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-highlight": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "UNLICENSED",
  "private": false
}
